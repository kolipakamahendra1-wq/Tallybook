# LLM for the brief text. ollama (local, free) | openai | anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional data enrichment. Without them: yfinance + Google News RSS.
# NEWSAPI_KEY=
# ALPHAVANTAGE_API_KEY=

# Set to require "Authorization: Bearer <token>" on /api/research and /api/reports*
# API_TOKEN=
# CORS_ORIGINS=http://localhost:5173
